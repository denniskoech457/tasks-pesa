{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/assets/(.*)", "dest": "/assets/$1" },

    { "src": "/api/(.*)", "dest": "/api/$1" },

    { "src": "/", "dest": "/api/index.php" },

    { "src": "/(.*\\.php)", "dest": "/api/$1" }
  ]
}
