{
  "functions": {
    "api/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    { "src": "/", "dest": "/api/index.php" },
    { "src": "/index.php", "dest": "/api/index.php" },
    { "src": "/auth.php", "dest": "/api/auth.php" },
    { "src": "/chat.php", "dest": "/api/chat.php" },
    { "src": "/check-payment.php", "dest": "/api/check-payment.php" },
    { "src": "/dashboard.php", "dest": "/api/dashboard.php" },
    { "src": "/logout.php", "dest": "/api/logout.php" },
    { "src": "/megapay-callback.php", "dest": "/api/megapay-callback.php" },
    { "src": "/megapay-initiate.php", "dest": "/api/megapay-initiate.php" },
    { "src": "/payment-pending.php", "dest": "/api/payment-pending.php" },
    { "src": "/payment-success.php", "dest": "/api/payment-success.php" },
    { "src": "/signin.php", "dest": "/api/signin.php" },
    { "src": "/signup.php", "dest": "/api/signup.php" },
    { "src": "/surveys.php", "dest": "/api/surveys.php" },
    { "src": "/trivia.php", "dest": "/api/trivia.php" }
  ]
}
